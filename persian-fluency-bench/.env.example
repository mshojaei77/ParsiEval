# Persian Fluency Bench configuration
# Copy this file to `.env` and fill in your values.

# --- Subject models (benchmarked models) ---
# API key for the OpenAI-compatible provider serving the subject models
EVAL_SUBJECT_API_KEY=

# Base URL (default: https://openrouter.ai/api/v1)
EVAL_SUBJECT_BASE_URL=https://openrouter.ai/api/v1

# Comma- or newline-separated list of model IDs to benchmark, e.g.:
# EVAL_SUBJECT_MODELS=qwen/qwen3-30b-a3b-instruct-2507,google/gemma-3-12b-it,mistralai/mistral-saba
EVAL_SUBJECT_MODELS=

# --- Judge (LLM-as-judge for linguistic fluency) ---
JUDGE_API_KEY=
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_MODEL=google/gemini-2.5-flash

# --- Optional generic fallbacks (used if the specific vars above are unset) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
